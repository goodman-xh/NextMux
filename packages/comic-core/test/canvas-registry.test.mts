import assert from 'node:assert/strict';
import test from 'node:test';
import { createCanvasDocument } from '../lib/canvas.js';
import type { CanvasDocument, CanvasNode } from '../lib/canvas.js';
import { cancelDeleteRegistryCanvas, closeRegistryCanvas, copyCanvasNodeToMain, createCanvasRegistry, createRegistryCanvas, deleteRegistryCanvas, listRegistryCanvases, orderRegistryCanvases, prepareDeleteRegistryCanvas, renameRegistryCanvas, reopenRegistryCanvas, validateCanvasRegistry } from '../lib/canvas-registry.js';

const now = '2026-10-01T10:00:00.000Z', later = '2026-10-01T11:00:00.000Z';
const main = createCanvasDocument({ id: 'canvas-legacy', projectId: 'project-legacy001', title: 'Legacy main', now });
test('legacy registration preserves the entire existing main document unchanged', () => {
  const before = JSON.stringify(main), registry = createCanvasRegistry(main.projectId, main);
  assert.equal(registry.mainCanvasId, main.id);
  assert.equal(registry.canvases[0].kind, 'main');
  assert.equal(registry.canvases[0].title, main.title);
  assert.equal(JSON.stringify(main), before);
  assert.equal(createCanvasRegistry(main.projectId, { ...main, title: 'x'.repeat(120) }).canvases[0].title.length, 120);
  assert.throws(() => createCanvasRegistry('other-project', main), { code: 'PROJECT_MISMATCH' });
});
test('canvas registry create, rename, close/reopen, order, and Trash tombstones retain main ownership', () => {
  const initial = createCanvasRegistry(main.projectId, main);
  const first = createRegistryCanvas(initial, { id: 'canvas-first', title: '  Explore  ', now });
  const second = createRegistryCanvas(first, { id: 'canvas-second', title: 'Second', now });
  assert.equal(first.canvases[1].title, 'Explore');
  const renamed = renameRegistryCanvas(second, 'canvas-first', 'Sketch', later);
  assert.equal(renamed.canvases[1].title, 'Sketch');
  const closed = closeRegistryCanvas(renamed, 'canvas-first', later);
  assert.deepEqual(listRegistryCanvases(closed, { openOnly: true }).map(item => item.id), [main.id, 'canvas-second']);
  assert.equal(listRegistryCanvases(closed).length, 3);
  const reopened = reopenRegistryCanvas(closed, 'canvas-first', later);
  assert.equal(reopened.canvases[1].isOpen, true);
  const ordered = orderRegistryCanvases(reopened, ['canvas-second', main.id, 'canvas-first'], later);
  assert.deepEqual(ordered.canvases.map(item => item.id), ['canvas-second', main.id, 'canvas-first']);
  assert.equal(ordered.mainCanvasId, main.id);
  const deleted = deleteRegistryCanvas(ordered, 'canvas-second', later);
  assert.deepEqual(listRegistryCanvases(deleted).map(item => item.id), [main.id, 'canvas-first']);
  assert.equal(listRegistryCanvases(deleted, { includeDeleted: true }).length, 3);
  assert.equal(deleted.canvases[0].deletedAt, later);
  assert.equal(deleted.canvases[0].isOpen, false);
  assert.equal(initial.canvases.length, 1);
  assert.throws(() => deleteRegistryCanvas(deleted, main.id, later), { code: 'MAIN_CANVAS_PROTECTED' });
  assert.throws(() => reopenRegistryCanvas(deleted, 'canvas-second', later), { code: 'CANVAS_NOT_FOUND' });
  assert.throws(() => createRegistryCanvas(deleted, { id: 'canvas-second', title: 'Duplicate', now }), { code: 'DUPLICATE_CANVAS_ID' });
  assert.throws(() => orderRegistryCanvases(reopened, [main.id, main.id, 'canvas-first'], later), { code: 'INVALID_CANVAS_ORDER' });
  const closedMain = closeRegistryCanvas(deleted, main.id, later);
  assert.equal(closedMain.canvases.find(item => item.id === main.id)?.isOpen, false);
  assert.equal(reopenRegistryCanvas(closedMain, main.id, later).mainCanvasId, main.id);
});
test('prepare deletion can cancel, protects main, and invalid registries reject orphaned main', () => {
  const registry = createRegistryCanvas(createCanvasRegistry(main.projectId, main), { id: 'canvas-extra', title: 'Extra', now });
  const prepared = prepareDeleteRegistryCanvas(registry, 'canvas-extra', later);
  assert.equal(prepared.canvases[1].deletionPending, true);
  assert.equal(cancelDeleteRegistryCanvas(prepared, 'canvas-extra', later).canvases[1].deletionPending, false);
  assert.equal(deleteRegistryCanvas(prepared, 'canvas-extra', later).canvases[1].deletionPending, false);
  assert.throws(() => prepareDeleteRegistryCanvas(registry, main.id, later), { code: 'MAIN_CANVAS_PROTECTED' });
  for (const raw of [null, {}, { ...registry, mainCanvasId: 'missing' }, { ...registry, canvases: registry.canvases.slice(1) }, { ...registry, canvases: [...registry.canvases, registry.canvases[1]] }]) assert.throws(() => validateCanvasRegistry(raw));
});
test('send selected current media to main places it beyond all existing content and retains its exact version', () => {
  const nodes: CanvasNode[] = [{ id: 'left', title: 'Left', kind: 'text', position: { x: -500, y: 200 }, size: { width: 200, height: 120 }, payload: { text: '' } }, { id: 'right', title: 'Right', kind: 'text', position: { x: 350, y: -100 }, size: { width: 300, height: 120 }, payload: { text: '' } }];
  const target: CanvasDocument = { ...main, nodes, revision: 5 };
  const sourceNode: CanvasNode = { id: 'result', title: 'Result', kind: 'imageGen', position: { x: 0, y: 0 }, size: { width: 240, height: 160 }, origin: { shotId: 'original-shot' }, payload: { modelId: 'image-model', mode: 'textToImage', prompt: '', parameters: {}, job: { id: 'running-original', status: 'running' }, versions: [{ id: 'old', assetId: 'asset-old', kind: 'image', uri: 'nextmux.media/old.png', createdAt: now }, { id: 'selected', assetId: 'asset-selected', kind: 'image', uri: 'nextmux.media/selected.png', createdAt: now }], currentVersionId: 'selected' } };
  const source: CanvasDocument = { ...createCanvasDocument({ id: 'canvas-extra', projectId: main.projectId, now }), nodes: [sourceNode] };
  const before = JSON.stringify(source);
  const result = copyCanvasNodeToMain(source, target, sourceNode.id, { nodeId: 'copied-result', now: later });
  assert.deepEqual(result.node.position, { x: 730, y: -100 });
  assert.equal(result.node.kind, 'image');
  assert.equal(result.node.payload.currentVersionId, 'selected');
  assert.equal(result.node.payload.versions.length, 1);
  assert.equal(result.node.payload.versions[0].uri, 'nextmux.media/selected.png');
  assert.equal(result.node.origin, undefined);
  assert.equal('job' in result.node.payload, false);
  assert.equal(result.document.id, main.id);
  assert.equal(result.document.revision, 6);
  assert.equal(result.document.nodes.length, 3);
  assert.equal(JSON.stringify(source), before);
  assert.equal(target.nodes.length, 2);
  assert.deepEqual(copyCanvasNodeToMain(source, main, sourceNode.id, { nodeId: 'empty-result', now: later }).node.position, { x: 0, y: 0 });
  assert.throws(() => copyCanvasNodeToMain(source, target, sourceNode.id, { nodeId: 'right', now: later }), { code: 'NODE_EXISTS' });
  assert.throws(() => copyCanvasNodeToMain(source, { ...target, projectId: 'another-project' }, sourceNode.id, { nodeId: 'copied-result', now: later }), { code: 'PROJECT_MISMATCH' });
  const missing = { ...source, nodes: [{ ...sourceNode, payload: { ...sourceNode.payload, currentVersionId: undefined } }] } as CanvasDocument;
  assert.throws(() => copyCanvasNodeToMain(missing, main, sourceNode.id, { nodeId: 'copied-result', now: later }), { code: 'NO_CURRENT_RESULT' });
});
