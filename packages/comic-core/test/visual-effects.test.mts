import assert from 'node:assert/strict';
import test from 'node:test';
import {GPU_EFFECT_REGISTRY,getGpuEffectDefaultParams,validateComicVisualEffects,validateComicVisualMasks,comicVisualProperties,type ComicVisualEffect,type ComicVisualMask} from '../lib/visual-effects.js';
import {validateComicComposition,evaluateComicCompositionProperty,splitComicCompositionClip,trimComicCompositionClip,applyComicCompositionOperation,type ComicCompositionClip,type ComicComposition} from '../lib/composition.js';
const context={assets:[],frameRate:24 as const,canvas:{width:64,height:48,aspectRatio:'4:3' as const}};
const effect=(type='gpu-exposure',id='e'):ComicVisualEffect=>({id,type,enabled:true,params:getGpuEffectDefaultParams(type)});
const mask=():ComicVisualMask=>({id:'m',shape:'path',scope:'clip',enabled:true,invert:false,x:.5,y:.5,width:.7,height:.7,rotation:0,feather:0,opacity:1,points:[{x:0,y:0},{x:1,y:0},{x:.5,y:1}]});
const clip=():ComicCompositionClip=>({id:'c',trackId:'t',kind:'text',from:0,durationFrames:48,sourceStartFrames:0,text:'Color',effects:[effect()],masks:[mask()]});
const composition=(c:ComicCompositionClip):ComicComposition=>({schemaVersion:1,tracks:[{id:'t',title:'T',kind:'text'}],clips:[c]});
test('fixed FreeCut registry retains all 54 effect IDs and valid canonical defaults',()=>{assert.equal(GPU_EFFECT_REGISTRY.size,54);for(const def of GPU_EFFECT_REGISTRY.values()){const value=validateComicVisualEffects([effect(def.id)]);assert.equal(value[0].type,def.id);assert.deepEqual(value[0].params,getGpuEffectDefaultParams(def.id));}});
test('legacy projects preserve absence of visual processing',()=>{const {effects:_,masks:__,...c}=clip();const result=validateComicComposition(composition(c),context);assert.equal(result.clips[0].effects,undefined);assert.equal(result.clips[0].masks,undefined);});
test('visual operations survive serialization, preserve ordering/enabled state and original state for undo',()=>{const base=validateComicComposition(composition(clip()),context);const next=applyComicCompositionOperation(base,{type:'clip.update',clipId:'c',patch:{effects:[effect('gpu-contrast','contrast'),{...effect('gpu-exposure','e'),enabled:false}]}},context);const reopened=validateComicComposition(JSON.parse(JSON.stringify(next)),context);assert.deepEqual(reopened,next);assert.deepEqual(next.clips[0].effects!.map(e=>[e.id,e.enabled]),[['contrast',true],['e',false]]);assert.equal(base.clips[0].effects![0].type,'gpu-exposure');});
test('effect and Bezier mask numeric keyframes preserve the original easing after trims and splits',()=>{const c:ComicCompositionClip={...clip(),keyframes:[{property:'effect:e:exposure',frame:0,value:-1,easing:'easeInOut'},{property:'effect:e:exposure',frame:48,value:2,easing:'linear'},{property:'mask:m:point.0.x',frame:0,value:0,easing:'easeOut'},{property:'mask:m:point.0.x',frame:48,value:.5,easing:'linear'}]};const checked=validateComicComposition(composition(c),context).clips[0];const trimmed=trimComicCompositionClip(checked,7,37),parts=splitComicCompositionClip(checked,19,'right');for(const property of ['effect:e:exposure','mask:m:point.0.x'] as const)for(let f=0;f<30;f++)assert.ok(Math.abs(evaluateComicCompositionProperty(trimmed,property,f)-evaluateComicCompositionProperty(checked,property,f+7))<1e-10);for(const part of parts)for(let f=0;f<part.durationFrames;f++)assert.ok(Math.abs(evaluateComicCompositionProperty(part,'effect:e:exposure',f)-evaluateComicCompositionProperty(checked,'effect:e:exposure',f+part.from))<1e-10);assert.ok(comicVisualProperties(checked).includes('mask:m:point.0.outX'));});
test('unsupported, malformed and out-of-range processing is rejected rather than silently lost',()=>{assert.throws(()=>validateComicVisualEffects([{...effect(),type:'unknown'}]));assert.throws(()=>validateComicVisualEffects([{...effect(),params:{exposure:99999}}]));assert.throws(()=>validateComicVisualMasks([{...mask(),points:[{x:0,y:0}]}]));assert.throws(()=>validateComicVisualMasks([{...mask(),feather:1000}]));assert.throws(()=>validateComicComposition(composition({...clip(),keyframes:[{property:'effect:missing:exposure',frame:0,value:0,easing:'linear'}]}),context));assert.throws(()=>validateComicComposition(composition({...clip(),keyframes:[{property:'mask:m:point.99.x',frame:0,value:0,easing:'linear'}]}),context));});
test('curves and LUT payloads are portable validated local data',()=>{const c=effect('gpu-curves');validateComicVisualEffects([{...c,params:{...c.params,masterPoints:'[[0,0],[0.4,0.7],[1,1]]'}}]);assert.throws(()=>validateComicVisualEffects([{...c,params:{...c.params,masterPoints:'[[1,0],[0,1]]'}}]));const lut=effect('gpu-lut'),bytes=Buffer.alloc(2**3*4,255).toString('base64');const checked=validateComicVisualEffects([{...lut,params:{...lut.params,lutSize:'2',lutData:bytes,lutName:'local.cube'}}]);assert.equal(checked[0].params.lutData,bytes);assert.throws(()=>validateComicVisualEffects([{...lut,params:{...lut.params,lutSize:'3',lutData:bytes}}]));});
