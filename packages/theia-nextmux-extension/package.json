{
  "name": "@nextmux/theia-extension",
  "version": "0.1.5",
  "private": true,
  "description": "NextMux desktop shell and workbench views for Eclipse Theia",
  "keywords": [
    "theia-extension"
  ],
  "license": "Apache-2.0",
  "files": [
    "lib",
    "src"
  ],
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@nextmux/agent-runtime": "workspace:*",
    "@nextmux/comic-core": "workspace:*",
    "@nextmux/media-core": "workspace:*",
    "@nextmux/model-runtime": "workspace:*",
    "@sparkjsdev/spark": "2.3.0",
    "@theia/ai-core": "1.74.1",
    "@theia/ai-mcp": "1.74.1",
    "@theia/core": "1.74.1",
    "@theia/filesystem": "1.74.1",
    "@theia/monaco": "1.74.1",
    "@theia/monaco-editor-core": "1.108.201",
    "@theia/preferences": "1.74.1",
    "@theia/process": "1.74.1",
    "@theia/terminal": "1.74.1",
    "@theia/workspace": "1.74.1",
    "@xyflow/react": "^12.12.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "htmlparser2": "10.0.0",
    "ipaddr.js": "2.5.0",
    "keytar": "7.9.0",
    "linkify-it": "5.0.2",
    "onnxruntime-node": "1.22.0",
    "pngjs": "7.0.0",
    "proper-lockfile": "4.1.2",
    "re2js": "2.8.6",
    "react": "18.3.1",
    "react-virtuoso": "4.18.12",
    "strip-ansi": "6.0.1",
    "three": "0.186.1",
    "undici": "7.29.0",
    "xterm": "5.3.0",
    "xterm-addon-fit": "0.8.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/linkify-it": "5.0.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.186.0",
    "rimraf": "6.1.3",
    "supports-color": "8.1.1",
    "typescript": "6.0.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-browser-assets.mjs",
    "clean": "rimraf lib",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs",
    "watch": "tsc -p tsconfig.json -w"
  },
  "theiaExtensions": [
    {
      "electronMain": "lib/electron-main/nextmux-electron-main-module"
    },
    {
      "frontend": "lib/browser/nextmux-frontend-module"
    },
    {
      "frontendPreload": "lib/browser/nextmux-preload-module"
    },
    {
      "backend": "lib/node/nextmux-backend-module"
    }
  ]
}
