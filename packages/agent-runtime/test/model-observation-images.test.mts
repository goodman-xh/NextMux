import test from 'node:test';
import assert from 'node:assert/strict';
import {modelObservationImages} from '../lib/model-observation-images.js';
import {AgentRunner,AgentToolRegistry,type AgentModelMessage,type AgentRunCheckpoint} from '../lib/index.js';
const image=(bytes=180000)=>({kind:'image' as const,name:'window-1',mimeType:'image/png' as const,dataBase64:'AAAA'.repeat(Math.ceil(bytes/3))});
function pair(i:number,windowId=9,bytes=180000):AgentModelMessage[]{return[{role:'assistant',content:'',toolCalls:[{id:'call-'+i,name:'computer.observe_window',arguments:{pid:7,windowId}}]},{role:'tool',toolCallId:'call-'+i,content:'text observation '+i,attachments:[image(bytes)]}];}
test('30 same-window observations retain only current outbound image; original payload and pairs remain',()=>{const messages=Array.from({length:30},(_,i)=>pair(i)).flat();const original=JSON.stringify(messages);assert(Buffer.byteLength(original)>4*1024*1024);const projected=modelObservationImages(messages);assert.equal(projected.length,messages.length);assert.equal(projected.filter(m=>m.attachments?.length).length,1);assert.equal(projected.at(-1),messages.at(-1));assert.match(projected[1].content,/Historical automation screenshot omitted/);assert.equal(JSON.stringify(messages),original);assert(Buffer.byteLength(JSON.stringify(projected))<4*1024*1024);});
test('latest per window is preserved; older snapshots of another window do not displace its latest',()=>{const messages=[...pair(1,9),...pair(2,10),...pair(3,9)];const projected=modelObservationImages(messages);assert.equal(projected[1].attachments,undefined);assert.equal(projected[3],messages[3]);assert.equal(projected[5],messages[5]);});
test('multi-window byte pressure preserves newest and tells model which older surface needs observation',()=>{const messages=[...pair(1,9,900000),...pair(2,10,900000)];const projected=modelObservationImages(messages);assert.equal(projected[1].attachments,undefined);assert.equal(projected[3],messages[3]);assert.match(projected[1].content,/Observe that surface again/);});
test('oversize latest capture is retained with an explicit transport boundary, never silently blind',()=>{const messages=pair(1,9,2400000);const projected=modelObservationImages(messages);assert.equal(projected[1].attachments,messages[1].attachments);assert.match(projected[1].content,/provider request-size limit still applies/);});
test('user images, generated media and unpaired attachments stay unchanged',()=>{const user:AgentModelMessage={role:'user',content:'source',attachments:[image()]};const generated:AgentModelMessage={role:'assistant',content:'generated',attachments:[image()]};const foreign:AgentModelMessage={role:'tool',toolCallId:'unknown',content:'source',attachments:[image()]};const messages=[user,generated,foreign,...pair(1),...pair(2)];const projected=modelObservationImages(messages);assert.equal(projected[0],user);assert.equal(projected[1],generated);assert.equal(projected[2],foreign);});
test('runner forwards bounded screenshots through 31 real loop turns but checkpoint retains all observations',async()=>{const tools=new AgentToolRegistry();tools.register({name:'computer.observe_window',description:'fixture observation',requiredPermission:'full_access',source:'builtin',inputSchema:{type:'object'}},async()=>({modelOutput:{text:'fixture'},summary:{title:'Observed'},attachments:[image()]}));let count=0,last:AgentRunCheckpoint|undefined;const result=await new AgentRunner({tools,permissionMode:'full_access',maxTurns:40,onCheckpoint:c=>{last=c;},model:{async complete(r){assert(Buffer.byteLength(JSON.stringify(r.messages))<4*1024*1024);return ++count<=30?{content:'',toolCalls:[{id:'capture-'+count,name:'computer.observe_window',arguments:{pid:7,windowId:9,maxTextChars:1000+count}}],usage:{inputTokens:10,outputTokens:10}}:{content:'done',toolCalls:[],usage:{inputTokens:10,outputTokens:10}};}}}).run({prompt:'Inspect fixture repeatedly'});assert.equal(result.status,'completed',result.stopReason);assert.equal(count,31);assert.equal(last?.messages.filter(m=>m.role==='tool'&&m.attachments?.length).length,30);});
